# Secrets für die Edge Functions. Kopieren nach supabase/.env.functions (wird NICHT eingecheckt),
# Werte eintragen, dann: npm run backend:setup
#
# Anthropic (Claude) – Text: Einschätzung, Trainingspläne, Coach-Tipps, Forum-Antworten
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
#
# Google Vertex AI (Gemini) – Foto/Video-Beobachtung in der EU
GCP_PROJECT_ID=
GCP_LOCATION=europe-west3
# Modellname von Vertex AI, der in europe-west3 verfügbar ist (in der Google-Cloud-Konsole prüfen)
GEMINI_MODEL=
# Service-Account-JSON (Rolle „Vertex AI User“), als eine Zeile oder base64
GCP_SERVICE_ACCOUNT_JSON=
#
# Wird vom Setup-Skript erzeugt, wenn leer (Absicherung der Cron-Aufrufe)
CRON_SECRET=
#
# Optional
EXPO_ACCESS_TOKEN=
REVENUECAT_WEBHOOK_SECRET=
